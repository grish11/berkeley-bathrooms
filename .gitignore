# Python virtual environment (uv creates .venv/ and manages it for you)
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]

# Original, full-resolution photos straight off the phone.
# Full-size originals stay on your laptop ONLY. They are large, and phone
# photos carry metadata including GPS coordinates and timestamps. You strip
# and resize these yourself before putting a copy in public/static/photos/,
# which IS committed. Never commit this folder -- the repo is public.
photos_raw/

# Secrets / local config
.env
.env.local

# Vercel CLI local state
.vercel/

# Editor + OS noise
.DS_Store
*.swp
.idea/
.vscode/
