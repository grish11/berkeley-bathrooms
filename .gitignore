# Python virtual environment (uv creates .venv/ and manages it for you)
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]

# Original, full-resolution photos straight off the phone.
# These stay on your laptop OUTSIDE this repo. They are large, and phone photos
# carry metadata including GPS coordinates and timestamps, and this repo is
# public. Only the stripped, resized copies in public/static/photos/ are
# committed. These patterns are a safety net in case one lands here anyway.
*.heic
*.HEIC
*.dng
*.DNG

# Secrets / local config
.env
.env.local

# Vercel CLI local state
.vercel/

# Editor + OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Personal working files. Not secret -- just mine, and not useful to anyone
# reading the repo. README.md and docs/ stay tracked on purpose: they are what
# a visitor (or future me) reads to understand and run the project.
#
# NOTE: listing a file here does not remove one already committed. That takes
#   git rm --cached <file>
# which stops tracking it while leaving it on disk.
CLAUDE.md
TODO.md
